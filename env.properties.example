# DEPRECATED: retained for one release for legacy installers only.
# New installations must use .env.example, which is the authoritative and
# complete template. This legacy file intentionally documents a subset (the
# keys an old installer wrote); it is not a full settings reference.
# Legacy AAC Assistant configuration template.
# Copy this file to .env only for older installers. New installations should
# copy .env.example to .env. The application migrates this file automatically.

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8086
FRONTEND_PORT=5176

# Database Configuration
DATABASE_NAME=aac_assistant.db
DATA_DIR=data

# Security Configuration
# The first application run replaces this placeholder with a strong secret.
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_STRING

# Logging Configuration
LOGS_DIR=logs
UPLOADS_DIR=uploads

# AI Provider Defaults
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter Configuration (optional)
OPENROUTER_API_KEY=

# Groq Configuration (optional)
GROQ_API_KEY=
# Optional production Groq model (DB setting wins; empty fails warmup closed).
GROQ_MODEL=

# Application Settings
APP_NAME=AAC Assistant
# APP_VERSION is derived from pyproject.toml; set it only to pin a deployment.
ENVIRONMENT=development

# Security Settings
ALLOWED_ORIGINS=http://localhost:5176,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5176

# Feature Flags
# ALLOW_DB_RESET: Enable/disable the admin database reset endpoint
# WARNING: Should ALWAYS be false in production!
ALLOW_DB_RESET=false

# Optional spend controls for the LLM-backed pictogram generator.
AUTOGEN_DAILY_CAP=-1
AUTOGEN_PACING_SECONDS=1.5
AUTOGEN_RATE_LIMIT_COOLDOWN_SECONDS=30

# Strict-moderation sentinel spend controls (-1 unlimited, 0 disabled).
SENTINEL_DAILY_CAP=-1
SENTINEL_PACING_SECONDS=1.5

# Comma-separated locales offered in the UI language switch.
SUPPORTED_UI_LANGUAGES=es-ES,en-US,es,en

# DEPRECATED legacy opt-in: allow the refresh token as a query parameter.
# Old clients get 400 unless this is true; keep it false.
AAC_REFRESH_ALLOW_QUERY_FALLBACK=false

# Launcher behavior flags (process environment, not this file).
# AAC_ASSISTANT_NO_BROWSER=1
# AAC_ASSISTANT_PORTABLE=0

# Sample Data Seeding (development only)
# Disabled by default for security in public deployments.
AAC_SEED_SAMPLE_DATA=false
# Optional: set deterministic seed passwords only for local demos/tests.
# AAC_SEED_DEFAULT_PASSWORD=
# AAC_SEED_STUDENT1_PASSWORD=
# AAC_SEED_TEACHER1_PASSWORD=
# AAC_SEED_ADMIN1_PASSWORD=

# Bootstrap Admin (first run convenience)
# If no admin exists, the app can create one automatically on first run.
# When no password is configured, the operator completes the initial setup screen
# (/setup) to choose a strong password.
AAC_BOOTSTRAP_ADMIN_ON_FIRST_RUN=true
AAC_BOOTSTRAP_ADMIN_USERNAME=admin1
# Optional explicit bootstrap password. Leave unset to use the first-run setup screen.
# AAC_BOOTSTRAP_ADMIN_PASSWORD=
