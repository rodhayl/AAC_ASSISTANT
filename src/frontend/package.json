{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "build": "tsc -b && vite build && node scripts/check-bundle-size.mjs",
    "build:e2e": "tsc -b && vite build --mode e2e",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:prod-build": "node scripts/verify-prod-build.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "i18next": "^24.0.0",
    "i18next-browser-languagedetector": "^7.1.0",
    "lucide-react": "^0.554.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "^15.0.0",
    "react-router": "8.3.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "globby": "^14.0.0",
    "jsdom": "^24.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
