# AAC Assistant configuration template
# Copy this file to .env. The first application run replaces the JWT placeholder
# with a strong random secret and keeps it stable on later runs.

# Server
# Local-first default: bind to loopback only. Set BACKEND_HOST=0.0.0.0 to
# deliberately expose the service to other machines on the network (requires
# strong credentials and reviewed CORS origins).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8086
BACKEND_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=10
FRONTEND_PORT=5176

# Database
DATABASE_NAME=aac_assistant.db
DATA_DIR=data

# Security
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_STRING
ALLOWED_ORIGINS=http://localhost:5176,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5176

# Logging
LOGS_DIR=logs
UPLOADS_DIR=uploads

# AI providers
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_API_KEY=

# Application
APP_NAME=AAC Assistant
APP_VERSION=2.0.0
ENVIRONMENT=development
DEFAULT_LOCALE=es

# Feature flags
ALLOW_DB_RESET=false
AAC_SEED_SAMPLE_DATA=false
# Optional maintenance task; enabling this performs external image lookups at startup.
AAC_ENABLE_SYMBOL_IMAGE_BACKFILL=false
AAC_SYMBOL_IMAGE_BACKFILL_LIMIT=100

# Bootstrap admin. When no password is configured, the first run generates a
# cryptographically random one-time credential and stores it in this file.
# Change it immediately after first login. Production refuses to start without
# an explicit, strong password here.
AAC_BOOTSTRAP_ADMIN_ON_FIRST_RUN=true
AAC_BOOTSTRAP_ADMIN_USERNAME=admin1
# AAC_BOOTSTRAP_ADMIN_PASSWORD=
