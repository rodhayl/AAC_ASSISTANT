# AAC Assistant configuration template
# Copy this file to .env. The first application run replaces the JWT placeholder
# with a strong random secret and keeps it stable on later runs.

# Server
# Local-first default: bind to loopback only. Set BACKEND_HOST=0.0.0.0 to
# deliberately expose the service to other machines on the network (requires
# strong credentials and reviewed CORS origins).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8086
BACKEND_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=10
FRONTEND_PORT=5176

# Database
DATABASE_NAME=aac_assistant.db
DATA_DIR=data

# Security
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_STRING
ALLOWED_ORIGINS=http://localhost:5176,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5176

# Logging
LOGS_DIR=logs
UPLOADS_DIR=uploads

# AI providers
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.5
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Optional production Groq model. The admin UI setting wins when set; this
# value is the fallback for env-only/initial deployments. Leave empty to make
# warmup fail closed rather than generate with an unverified default.
GROQ_MODEL=

# Application
APP_NAME=AAC Assistant
APP_VERSION=2.0.0
ENVIRONMENT=development
DEFAULT_LOCALE=es

# Feature flags
ALLOW_DB_RESET=false
AAC_SEED_SAMPLE_DATA=false
# Optional maintenance task; enabling this performs external image lookups at startup.
AAC_ENABLE_SYMBOL_IMAGE_BACKFILL=false
AAC_SYMBOL_IMAGE_BACKFILL_LIMIT=100
# One-time bulk import of the full ARASAAC library on first startup.
AAC_ENABLE_ARASAAC_LIBRARY_IMPORT=false
# Comma-separated locales to import. Pictograms are locale-independent, so each
# locale materializes its translated labels reusing the same images.
AAC_ARASAAC_LIBRARY_LOCALES=es,en
# Rebuild n-gram prediction models from real symbol usage logs at startup.
# Writes writable data/ngrams models; bundled seed files are never modified.
AAC_ENABLE_NGRAM_REBUILD=false
# Seconds between periodic n-gram rebuilds while the server runs, so the model
# keeps learning from new usage without a restart. 0 = startup-only rebuild.
AAC_NGRAM_REBUILD_INTERVAL_SECONDS=3600

# Optional spend controls for the LLM-backed pictogram generator (AAC board AI).
# -1 = unlimited; positive = daily ceiling / seconds between calls.
AUTOGEN_DAILY_CAP=-1
AUTOGEN_PACING_SECONDS=1.5
AUTOGEN_RATE_LIMIT_COOLDOWN_SECONDS=30

# Strict-moderation sentinel (Layer 2 output check) spend controls.
# -1 = unlimited, 0 = sentinel disabled, positive = daily cap on LLM calls.
SENTINEL_DAILY_CAP=-1
SENTINEL_PACING_SECONDS=1.5

# Comma-separated locales offered in the UI language switch.
SUPPORTED_UI_LANGUAGES=es-ES,en-US,es,en

# DEPRECATED legacy opt-in: allow the refresh token to be supplied as a query
# parameter. Old clients that still use it receive 400 unless this is true;
# the opt-in exists so operators can migrate, and it should stay false.
AAC_REFRESH_ALLOW_QUERY_FALLBACK=false

# Launcher behavior flags (read from the process environment, not .env).
# AAC_ASSISTANT_NO_BROWSER=1 opens the server without launching a browser.
# AAC_ASSISTANT_PORTABLE=1 forces portable (installation-dir) data paths.
# AAC_ASSISTANT_NO_BROWSER=0
# AAC_ASSISTANT_PORTABLE=0

# Bootstrap administrator. When no password is configured, the application
# prompts the operator to complete the initial setup screen (/setup) on first run.
# Alternatively, set an explicit strong password here. In production, an explicit
# unique password is mandatory if bootstrap is enabled.
AAC_BOOTSTRAP_ADMIN_ON_FIRST_RUN=true
AAC_BOOTSTRAP_ADMIN_USERNAME=admin1
# Optional explicit bootstrap password. Leave unset to use the first-run setup screen.
# AAC_BOOTSTRAP_ADMIN_PASSWORD=
