# AAC Assistant configuration template
# Copy this file to .env. The first application run replaces the JWT placeholder
# with a strong random secret and keeps it stable on later runs.

# Server
# Local-first default: bind to loopback only. Set BACKEND_HOST=0.0.0.0 to
# deliberately expose the service to other machines on the network (requires
# strong credentials and reviewed CORS origins).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8086
BACKEND_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=10
FRONTEND_PORT=5176

# Database
DATABASE_NAME=aac_assistant.db
DATA_DIR=data

# Security
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_STRING
ALLOWED_ORIGINS=http://localhost:5176,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5176

# Logging
LOGS_DIR=logs
UPLOADS_DIR=uploads

# AI providers
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_API_KEY=

# Application
APP_NAME=AAC Assistant
APP_VERSION=2.0.0
ENVIRONMENT=development
DEFAULT_LOCALE=es

# Feature flags
ALLOW_DB_RESET=false
AAC_SEED_SAMPLE_DATA=false
# Optional maintenance task; enabling this performs external image lookups at startup.
AAC_ENABLE_SYMBOL_IMAGE_BACKFILL=false
AAC_SYMBOL_IMAGE_BACKFILL_LIMIT=100
# One-time bulk import of the full ARASAAC library on first startup.
AAC_ENABLE_ARASAAC_LIBRARY_IMPORT=false
# Comma-separated locales to import. Pictograms are locale-independent, so each
# locale materializes its translated labels reusing the same images.
AAC_ARASAAC_LIBRARY_LOCALES=es,en
# Rebuild n-gram prediction models from real symbol usage logs at startup.
# Writes writable data/ngrams models; bundled seed files are never modified.
AAC_ENABLE_NGRAM_REBUILD=false

# Bootstrap administrator. When no password is configured, the application
# prompts the operator to complete the initial setup screen (/setup) on first run.
# Alternatively, set an explicit strong password here. In production, an explicit
# unique password is mandatory if bootstrap is enabled.
AAC_BOOTSTRAP_ADMIN_ON_FIRST_RUN=true
AAC_BOOTSTRAP_ADMIN_USERNAME=admin1
# Local development bootstrap only. Change this password immediately after first login.
AAC_BOOTSTRAP_ADMIN_PASSWORD=Admin123
